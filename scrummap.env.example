# ==============================================================================
# ScrumMap: Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to '.env' in your local root directory and populate it with
# your specific keys. Never commit the resulting '.env' file containing secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System Ports and Network Bindings
# ------------------------------------------------------------------------------
PORT_FRONTEND=3000
PORT_BACKEND=8000
BIND_ADDRESS=127.0.0.1  # Set to '0.0.0.0' inside Podman container namespaces

# ------------------------------------------------------------------------------
# 2. Local Database Configuration (SQLite)
# ------------------------------------------------------------------------------
DATABASE_PATH=/workspace/data/governance.db

# Database Performance Pragmas
SQLITE_JOURNAL_MODE=WAL
SQLITE_SYNCHRONOUS=NORMAL
SQLITE_FOREIGN_KEYS=ON

# ------------------------------------------------------------------------------
# 3. LLM Provider Integration (FAU Trussed.ai & Local Offline Fallbacks)
# ------------------------------------------------------------------------------
# Active LLM Gateway Provider: 'trussed' or 'openai-compatible' (for LM Studio)
LLM_PROVIDER=trussed

# Active Model ID: 'gemini-2.5-pro' (HootCamp Gemini) or 'gpt-5.4' (HootCamp OpenAI)
LLM_MODEL=gemini-2.5-pro

# Your FAU Trussed.ai API Key (Get yours at https://trussed.hpc.fau.edu)
# NEVER commit your actual key to git! Keep it local and secure.
TRUSSED_API_KEY=YOUR_TRUSSED_API_KEY_HERE
TRUSSED_API_URL=https://fauengtrussed.fau.edu/provider/generic

# Local Offline Development Settings (e.g., LM Studio/Local LLM Testing)
OPENAI_API_KEY=lm-studio
OPENAI_BASE_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=qwen/qwen2.5-27b-instruct

# ------------------------------------------------------------------------------
# 4. Ingestion Pipelines & Security Guardrails
# ------------------------------------------------------------------------------
UPLOAD_DIR=/tmp/scrummap_uploads

# Security Overwrite Caps
MAX_ZIP_SIZE_BYTES=1610612736  # Hard limit (1.5 GB in bytes)
MAX_FILE_COUNT=50000           # Decompression limits to block zip bombs
ZDR_COMPLIANCE=TRUE            # Automatically purges raw codebase directories after AST extraction

# Team telemetry and process limits
ESCALATION_PROMPT_CAP=8        # Pivot to manual debugging if prompt iterations exceed this limit

# ------------------------------------------------------------------------------
# 5. Logging and Observability Strategy
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO                 # OPTIONS: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=JSON                # OPTIONS: JSON, TEXT
